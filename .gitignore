skills/
node_modules/
tsconfig.tsbuildinfo
dev.log
**/dev.log
*.tmp
*.bak
.next/
db/*.db
*.db

# runtime logs
mini-services/*/service.log
mini-services/*/ws.log
tool-results/

# runtime state — never commit process ids or service logs (audit 2)
*.pid
.zscripts/*.log

# durable push-target state (contains the PAT — NEVER commit)
.loop-push-state.json
/public/loop-source.zip

# environment (real .env is untracked; .env.example is the template)
.env
.env.local

# disposable test-verification sandboxes (core/sandbox-test.ts) —
# candidate code lives here during `bun test` and is deleted afterwards;
# must never be swept into a commit by git add -A
.loop-sandbox/

# uploaded repo snapshots — never commit 99MB of zips (audit finding 5)
upload/
loop-ws.log
mini-services/loop-worker/worker.log

# ws-service runtime log (same policy as dev.log — audit 2)
dev-ws.log

# loop-state working directory — the learning-state JSON exports. The
# durable copy lives on the `loop-state` BRANCH (pushed by the batch
# workflow); the working-tree copy is a local artifact restored by
# `bun scripts/loop-state.ts import` and must never be committed to
# main (it would pollute the code branch with state diffs).
loop-state/

# forensic DB snapshots (within-machine only; the durable tier is
# .git/info/loop-db-backup/ which is untracked by design)
db/*.db.pre-push-snapshot
db/*.db.evidence-*
