// Architecture Helper Pipeline — Prisma schema
// SQLite-backed persistence for pipeline runs, autonomous cycles, and RAG memory.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A single execution of the 6-stage refactoring pipeline on one file.
model PipelineRun {
  id             String   @id @default(cuid())
  pipelineId     String   @unique
  targetRepo     String
  targetBranch   String
  evolutionBranch String
  filePath       String
  userPrompt     String
  siphonSourceId String
  status         String   // COMPLETED | REJECTED | HALTED | SANITIZED_APPLIED
  astScore       Int
  consensus      String
  proofHash      String
  originalCode   String
  evolvedCode    String
  sanitizerClean Boolean
  violations     String   // JSON array
  triggeredBy    String   // manual | autonomous | watch | continuous
  createdAt      DateTime @default(now())
}

/// One cycle of the autonomous self-enhancement loop.
model AutonomousCycle {
  id              String   @id @default(cuid())
  cycleNumber     Int
  mode            String   // scheduled | watch | continuous | manual
  targetRepo     String
  branch         String
  filesScanned   Int
  filesCommitted Int
  status         String   // running | completed | error | halted
  proofHash      String?
  error          String?
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
}

/// Long-term memory entries (RAG-style).
model MemoryEntry {
  id          String   @id @default(cuid())
  provenance  String   // clean | failure | synthesis | contradicted
  trust       String   // high | medium | low | revoked
  filePath    String?
  ruleToAvoid String?
  diagnosis   String?
  cleanSnippet String?
  content     String
  createdAt   DateTime @default(now())
}

/// Per-file postmortem — negative constraints learned from past failures.
/// One record per (repo, branch, filePath). Active postmortems feed constraints
/// into the LLM refactorer before mutation. Resolved postmortems are kept for
/// history but skipped during constraint injection.
model Postmortem {
  id           String   @id @default(cuid())
  targetRepo   String
  branch       String
  filePath     String
  status       String   // active | resolved
  failureType  String   // AST_SYMBOL_DROPPED | AST_STRUCTURAL_DRIFT | REVIEW_REJECTED | SANITIZER_REDCTION | HEADER_STRIPPED | COMPILE_ERROR | OTHER
  symptom      String   // human-readable one-line summary
  evidence     String   // machine-copied facts (AST violations, dropped symbols, etc.)
  constraints  String   // imperative instructions the LLM must follow
  attempts     Int      @default(1)  // how many times this file has failed
  lastAttemptAt DateTime @default(now())
  resolvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([targetRepo, branch, filePath])
}

/// Persistent GitHub push target for the self-enhance loop.
/// Singleton row (id = "singleton"). Stores the token used to authenticate
/// git pushes of the system's own evolving source. The token is NEVER
/// returned to the client — API routes redact it.
model GitPushTarget {
  id                String    @id @default("singleton")
  repo              String    // "owner/name" on github.com
  token             String    // classic PAT (ghp_...) or fine-grained PAT (github_pat_...)
  branch            String    @default("main") // seed branch — the configured home; each successful enhancement forks a new loop-NN branch off it
  createdRepo       Boolean   @default(false) // true if we auto-created the repo
  lastPushAt        DateTime?
  lastPushSha       String?   // short sha of last successful push
  lastPushError     String?   // last push failure message (token-free)
  // Per-cycle branch counter. After the Nth successful enhancement, this is N
  // and the next enhancement will push to loop-{N+1} (zero-padded to 2 digits
  // → loop-01 .. loop-99, then loop-100). Failed attempts do NOT increment —
  // only full mutations (test pin + enhancement both committed) get a branch.
  lastBranchNumber  Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/// On-demand chat/task engine (restored from the Original-branch lineage).
/// A task is a single concrete finding in the codebase that the chat-driven
/// agent (or manual rescan) can pick up, fix through the gated pipeline,
/// and mark done. The unique key prevents duplicate tasks for the same
/// finding at the same location.
model SelfTask {
  id         String    @id @default(cuid())
  kind       String    // todo-comment | empty-catch | any-usage | missing-return-type | magic-number | non-null-assertion
  filePath   String    // relative to project root
  line       Int       // 1-based
  evidence   String    // the matched source line (trimmed)
  priority   Int       // lower = more important
  status     String    @default("pending") // pending | in_progress | done | failed | skipped
  attempts   Int       @default(0)
  deferred   Int       @default(0)  // times LLM was unavailable (429)
  lastError  String?
  fixSummary String?   // what the fix actually did
  commitSha  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  doneAt     DateTime?

  @@unique([kind, filePath, line])
}

/// Gemini direct-call configuration (singleton). Stores the user-pasted
/// Gemini API key — or, when GEMINI_PROXY_BASE_URL is set, the proxy's
/// shared secret — plus the model name and the last call's outcome for
/// the UI status indicator. The key is NEVER returned to the client;
/// the GET route redacts it. Server-side only.
///
/// This model was previously removed from the schema (causing
/// /api/self-enhance/llm-config to 500 with "Cannot read properties of
/// undefined (reading 'findUnique')"). Restored 2026-10-29 — without
/// it, the entire Gemini-direct path is broken at the storage layer,
/// and retry/recovery logic in gemini-direct.ts has nothing to read
/// from. Singleton pattern, same as GitPushTarget.
model LlmConfig {
  id           String    @id @default("singleton")
  geminiApiKey  String    // real Google AI Studio key, OR the proxy shared secret when GEMINI_PROXY_BASE_URL is set
  geminiModel   String    @default("gemini-2.5-flash") // e.g. gemini-2.5-pro | gemini-2.5-flash | gemini-2.0-flash
  lastUsedAt   DateTime?  // last successful generateContent call
  lastError    String?    // last error message (token-free, scrubbed)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
