// Architecture Helper Pipeline — Prisma schema
// SQLite-backed persistence for pipeline runs, autonomous cycles, and RAG memory.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A single execution of the 6-stage refactoring pipeline on one file.
model PipelineRun {
  id             String   @id @default(cuid())
  pipelineId     String   @unique
  targetRepo     String
  targetBranch   String
  evolutionBranch String
  filePath       String
  userPrompt     String
  siphonSourceId String
  status         String   // COMPLETED | REJECTED | HALTED | SANITIZED_APPLIED
  astScore       Int
  consensus      String
  proofHash      String
  originalCode   String
  evolvedCode    String
  sanitizerClean Boolean
  violations     String   // JSON array
  triggeredBy    String   // manual | autonomous | watch | continuous
  createdAt      DateTime @default(now())
}

/// One cycle of the autonomous self-enhancement loop.
model AutonomousCycle {
  id              String   @id @default(cuid())
  cycleNumber     Int
  mode            String   // scheduled | watch | continuous | manual
  targetRepo     String
  branch         String
  filesScanned   Int
  filesCommitted Int
  status         String   // running | completed | error | halted
  proofHash      String?
  error          String?
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
}

/// Long-term memory entries (RAG-style).
model MemoryEntry {
  id          String   @id @default(cuid())
  provenance  String   // clean | failure | synthesis | contradicted
  trust       String   // high | medium | low | revoked
  filePath    String?
  ruleToAvoid String?
  diagnosis   String?
  cleanSnippet String?
  content     String
  createdAt   DateTime @default(now())
}

/// Per-file postmortem — negative constraints learned from past failures.
/// One record per (repo, branch, filePath). Active postmortems feed constraints
/// into the LLM refactorer before mutation. Resolved postmortems are kept for
/// history but skipped during constraint injection.
///
/// ── Tamper-evident chain (concept: Aether_Forge Ω darlekRAG) ──────────
/// `parentHash` is the `hash` of the previously-created postmortem (ordered
/// by createdAt). `hash` is sha256(parentHash + canonical(record content)),
/// recomputed on every write. verifyLineageChain() walks the chain and
/// reports (a) link breaks — a child's parentHash ≠ its predecessor's
/// current hash, which happens whenever an older record is UPDATED in
/// place (informational, expected on repeat failures), and (b) content
/// mismatches — a record's stored hash ≠ recomputed hash, which means
/// someone tampered with the row directly in the DB (alarm). The chain
/// makes the failure memory auditable: you can prove the order records
/// were created in, and detect direct DB edits, without a separate log.
///
/// ── Verification lifecycle (concept: Aether_Forge CANDIDATE→VERIFIED) ─
/// `verificationStatus` gates whether a postmortem's constraints are
/// injected into the LLM prompt:
///   - verified   — recorded from a REAL pipeline failure observed by
///                  this system. Safe to inject. (recordFailure default.)
///   - candidate  — seeded from an EXTERNAL markdown file (someone else
///                  claimed this file fails this way). Kept as a watch
///                  list; NOT injected until this system observes the
///                  same failure (which upgrades it to verified) or the
///                  file succeeds (which rejects it).
///   - rejected   — a candidate that was contradicted by reality (the
///                  file was successfully committed without the claimed
///                  failure occurring). Kept for history; not injected.
/// getConstraintsForFile only injects active + verified postmortems.
model Postmortem {
  id           String   @id @default(cuid())
  targetRepo   String
  branch       String
  filePath     String
  status       String   // active | resolved
  // Verification lifecycle — gates LLM-prompt injection. See model doc.
  verificationStatus String @default("verified") // verified | candidate | rejected
  failureType  String   // AST_SYMBOL_DROPPED | AST_STRUCTURAL_DRIFT | REVIEW_REJECTED | SANITIZER_REDCTION | HEADER_STRIPPED | COMPILE_ERROR | WEAK_RATCHET | OTHER
  symptom      String   // human-readable one-line summary
  evidence     String   // machine-copied facts (AST violations, dropped symbols, etc.)
  constraints  String   // imperative instructions the LLM must follow
  attempts     Int      @default(1)  // how many times this file has failed
  // ── D7: REFLEXION (concept: noahshinn/reflexion, NeurIPS 2023) ─────
  // After a failed mutation, one cheap LLM call asks the model to
  // articulate WHY its own reasoning produced the failure — a verbal
  // self-diagnosis, stored here and injected with the next attempt's
  // postmortem block. Reflexion's finding: self-reflection stored
  // across trials materially reduces repetition of the same reasoning
  // error. One per (filePath) — the newest reflection replaces the
  // older, keeping the prompt bounded.
  reflection    String?
  // Tamper-evident chain. parentHash = hash of the previous postmortem
  // (by createdAt) at THIS record's creation time. hash = sha256 over
  // (parentHash + canonical content), recomputed on every write. See
  // model doc for the link-break vs content-mismatch distinction.
  parentHash   String?
  hash         String?
  lastAttemptAt DateTime @default(now())
  resolvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([targetRepo, branch, filePath])
}

/// Persistent GitHub push target for the self-enhance loop.
/// Singleton row (id = "singleton"). Stores the token used to authenticate
/// git pushes of the system's own evolving source. The token is NEVER
/// returned to the client — API routes redact it.
model GitPushTarget {
  id                String    @id @default("singleton")
  repo              String    // "owner/name" on github.com
  token             String    // classic PAT (ghp_...) or fine-grained PAT (github_pat_...)
  branch            String    @default("main") // seed branch — the configured home; each successful enhancement forks a new loop-NN branch off it
  createdRepo       Boolean   @default(false) // true if we auto-created the repo
  lastPushAt        DateTime?
  lastPushSha       String?   // short sha of last successful push
  lastPushError     String?   // last push failure message (token-free)
  // Per-cycle branch counter. After the Nth successful enhancement, this is N
  // and the next enhancement will push to loop-{N+1} (zero-padded to 2 digits
  // → loop-01 .. loop-99, then loop-100). Failed attempts do NOT increment —
  // only full mutations (test pin + enhancement both committed) get a branch.
  lastBranchNumber  Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/// On-demand chat/task engine (restored from the Original-branch lineage).
/// A task is a single concrete finding in the codebase that the chat-driven
/// agent (or manual rescan) can pick up, fix through the gated pipeline,
/// and mark done. The unique key prevents duplicate tasks for the same
/// finding at the same location.
model SelfTask {
  id         String    @id @default(cuid())
  kind       String    // todo-comment | empty-catch | any-usage | missing-return-type | magic-number | non-null-assertion
  filePath   String    // relative to project root
  line       Int       // 1-based
  evidence   String    // the matched source line (trimmed)
  priority   Int       // lower = more important
  status     String    @default("pending") // pending | in_progress | done | failed | skipped
  attempts   Int       @default(0)
  deferred   Int       @default(0)  // times LLM was unavailable (429)
  lastError  String?
  fixSummary String?   // what the fix actually did
  commitSha  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  doneAt     DateTime?

  @@unique([kind, filePath, line])
}

/// Gemini direct-call configuration (singleton). Stores the user-pasted
/// Gemini API key — or, when GEMINI_PROXY_BASE_URL is set, the proxy's
/// shared secret — plus the model name and the last call's outcome for
/// the UI status indicator. The key is NEVER returned to the client;
/// the GET route redacts it. Server-side only.
///
/// This model was previously removed from the schema (causing
/// /api/self-enhance/llm-config to 500 with "Cannot read properties of
/// undefined (reading 'findUnique')"). Restored 2026-10-29 — without
/// it, the entire Gemini-direct path is broken at the storage layer,
/// and retry/recovery logic in gemini-direct.ts has nothing to read
/// from. Singleton pattern, same as GitPushTarget.
///
/// NVIDIA NIM fields (nvidiaApiKey, nvidiaModel, nvidiaLastUsedAt,
/// nvidiaLastError) added 2026-11 — NVIDIA's free hosted catalog is
/// tier 1 in the chain (fastest, no geo-block from HK). When configured,
/// the loop calls Bolt FIRST and falls through to Gemini → Z.AI on any
/// NVIDIA failure. Models rotate without notice on the free endpoint,
/// so nvidiaLastError surfaces 410 Gone as a clear "swap the model id"
/// message.
model LlmConfig {
  id           String    @id @default("singleton")
  geminiApiKey  String    @default("") // real Google AI Studio key, OR the proxy shared secret when GEMINI_PROXY_BASE_URL is set. Empty = not configured (default, so an NVIDIA-only setup can create a row without a Gemini key).
  geminiModel   String    @default("gemini-2.5-flash") // e.g. gemini-2.5-pro | gemini-2.5-flash | gemini-2.0-flash
  lastUsedAt   DateTime?  // last successful generateContent call (Gemini leg)
  lastError    String?    // last Gemini error message (token-free, scrubbed)
  // ── NVIDIA NIM (tier 1) ──────────────────────────────────────────────
  // The NVIDIA key is optional (empty string when unset). When non-empty,
  // nvidia-direct.ts is tried FIRST in the chain. Default model is the
  // tested-fastest free-catalog model (Bolt — 1.7s tribunal, 14s refactor).
  nvidiaApiKey String    @default("") // nvapi-... key from build.nvidia.com
  nvidiaModel  String    @default("nvidia/nemotron-3.5-bolt-e4b") // OpenAI-compatible model id
  nvidiaLastUsedAt DateTime? // last successful NVIDIA chat-completions call
  nvidiaLastError String?    // last NVIDIA error (scrubbed; surfaces 410 Gone clearly)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// A falsifiable prediction the system makes about its own future.
///
/// Each prophecy is generated from the system's recent history (git log,
/// worklog, postmortems) by the LLM, then stored. Over time, the
/// evaluator checks pending prophecies against new events and marks
/// them fulfilled, failed, or leaves them pending. The track record
/// (fulfilled / failed / still-pending counts, plus a calibration
/// metric) is surfaced in the UI as the system's "metacognition" — a
/// real, measurable form of self-reflection.
///
/// Why this model exists: the system already mutates its own source.
/// Adding prophecy/evaluation gives it a way to test its own model of
/// itself. A system that can predict its own failures with calibrated
/// confidence is doing something closer to self-awareness than one that
/// simply reacts. The track record is the evidence.
///
/// The prophecy is NOT a goal. The system does not work to make
/// prophecies come true; it works on whatever the SelfTask queue
/// prioritizes. The prophecy is a prediction about that work, made
/// before the work happens, judged after.
///
/// Falsifiability is enforced: every prophecy must include a
/// falsifiabilityCriterion (what evidence would confirm/refute it).
/// The generator rejects any prophecy without one. Vague unfalsifiable
/// claims ("the system will continue to evolve") don't get saved —
/// they'd never be evaluable and would inflate the pending count
/// forever.
model Prophecy {
  id              String    @id @default(cuid())
  // The actual prediction. One sentence, future-tense, specific enough
  // to be evaluable against real events. Examples:
  //   "The next mutation will fail the AST diff gate by dropping an export."
  //   "Within 5 cycles, a postmortem will be written for src/lib/pipeline/llm/agent-llm.ts."
  //   "The next 3 mutations will all pass every gate on the first attempt."
  claim           String

  // LLM's stated confidence, 0.0 to 1.0. Used for the calibration metric:
  // of all prophecies with confidence >= 0.7, what fraction came true?
  // A well-calibrated system should be right ~70% of the time on that
  // band. Tracking this over many prophecies turns "confidence" from
  // a feeling into a measurement.
  confidence      Float

  // Why the LLM thinks the claim will come true. Includes the historical
  // patterns it's reasoning from. Lets a human reviewer audit the
  // reasoning later, and lets the evaluator check whether the rationale
  // matches what actually happened.
  rationale       String

  // The falsifiability criterion: what specific evidence would confirm
  // or refute this prophecy. The evaluator uses this as the rubric. If
  // empty, the prophecy is rejected at generation time — we don't store
  // predictions we can never judge.
  falsifiabilityCriterion  String

  // Lifecycle: pending (waiting for evaluateBy), fulfilled (came true),
  // failed (did not come true), retired (deadline passed without enough
  // evidence to judge — rare, used when the criterion is uncheckable).
  status          String    @default("pending") // pending | fulfilled | failed | retired

  // Deadline for evaluation. The evaluator only judges prophecies past
  // this date (or manually triggered). Set by the generator based on
  // the claim's horizon — "next mutation" = +1 cycle, "within 5 cycles"
  // = +5 cycles, etc. Stored as DateTime, computed from createdAt +
  // horizonCycles * estimatedCycleMs.
  evaluateBy      DateTime

  // When the evaluator actually judged it (null while pending). Lets
  // the UI show how long after the deadline the judgment happened.
  evaluatedAt     DateTime?

  // The evaluator's reasoning, recorded when status changes from
  // pending. Explains which evidence was found and how it matched (or
  // didn't match) the falsifiabilityCriterion. Empty while pending.
  evaluation      String?

  // The commit SHA at prophecy-generation time. Gives the evaluator a
  // reference point: "the system was at SHA X when it predicted Y; the
  // current state is SHA Z; here's what happened in between." Lets the
  // evaluator do a real `git log X..Z` diff to check the claim.
  contextSha      String?

  // A brief summary of the history the LLM saw when generating. Lets
  // the evaluator check the prophecy against the SAME context the LLM
  // had (not just the current state). Without this, the evaluator might
  // judge a prophecy against events the LLM couldn't have known about.
  historySnapshot String?

  // Optional: which subsystem the prophecy is about. Helps the UI
  // filter ("show me all prophecies about the LLM caller"). Free-text
  // tag set by the LLM, e.g. "llm" | "gates" | "push" | "postmortem" |
  // "ui" | "system". Not enumerated because we don't want to constrain
  // the LLM's categorical vocabulary.
  domain          String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// Generic key/value runtime flag store. Used by the duress/purge protocol
/// (concept grafted from craighckby-stack/PKM — see docs/CONCEPTS-GRAFTED.md
/// GRAFT 2) to persist a "safe-mode" flag the autonomous loop reads before
/// each cycle. When set, the loop refuses to mutate or push until an
/// operator clears it.
///
/// Singleton-per-key: each key has exactly one row. value is a short
/// string ("true"/"false"/a reason). setAt is when the flag was last
/// raised. setBy records which subsystem raised it (e.g. "duress",
/// "red-team", "operator"). reason is a human-readable explanation.
model SystemFlag {
  key       String   @id           // e.g. "safe-mode"
  value     String                 // "true" | "false"
  setBy     String   @default("system")  // "duress" | "red-team" | "operator" | "system"
  reason    String?                // why the flag was raised
  setAt     DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// ── COMPOUNDING INTELLIGENCE ─────────────────────────────────────────
/// A GENERAL lesson distilled from the system's accumulated experience.
///
/// Postmortems are per-file and reactive: they only fire for the exact
/// file that failed, and only after the failure. That's a scar log, not
/// intelligence — knowing `halt.ts` hates function removal doesn't help
/// when the loop picks `sanitizer.ts`.
///
/// Lessons are the transfer layer. Periodically (every DISTILL_INTERVAL
/// cycles) the loop asks the LLM to look at AGGREGATE failure patterns +
/// recent successful change summaries and extract up to 3 GENERAL rules
/// ("across 14 failures, 9 were the LLM deleting error-handling branches
/// — never remove try/catch blocks"). These inject into EVERY enhance
/// prompt, not just the failing file's.
///
/// The compounding loop is distill → inject → measure → prune:
///   - distill: LLM extracts general rules from aggregate history
///   - inject: top-K lessons by trust score go into every prompt
///   - measure: every mutation verdict feeds back — pass → helped++,
///     fail → hindered++ for the lessons that were injected
///   - prune: score = helped/(helped+hindered); a lesson below 0.35
///     after >= 4 observations is deactivated (it didn't transfer)
///
/// This is meta-learning with a real feedback signal: the system learns
/// WHICH of its own lessons actually raise the pass rate, and keeps only
/// those. That's what makes it compound — each surviving lesson makes
/// future mutations more likely to succeed, which the score proves.
///
/// This model is in the SCHEMA-PROTECTED list: the loop can never edit
/// or drop it (the additive-only schema gate rejects any diff touching
/// it). A self-improving system must not be able to forget its own
/// learning substrate.
model Lesson {
  id        String   @id @default(cuid())

  // The general imperative rule. One or two sentences, applies ACROSS
  // files, phrased so it can be injected verbatim into any enhance
  // prompt. e.g. "Never remove error-handling branches — the debate
  // gate rejects 'simplification' of try/catch blocks."
  content   String

  // Where it came from: "distilled" (LLM pass over aggregate history)
  // or "seed" (hand-planted at schema-creation time).
  sourceType String  @default("distilled")

  // How many postmortems/events fed the distillation that produced it.
  // Higher = broader evidence base = started with more trust.
  sourceCount Int    @default(1)

  // ── D2: TWO-TRACK GRADUATION (concept: yungbose/upskill) ───────────
  // A PROCEDURE is an always-true operating rule ("never remove error
  // handling without a replacement") — it survives noisy judgment
  // streaks, prunes at a stricter floor, and at high lapse counts is
  // PROMOTED to the permanent Operating Constraints block (injected
  // regardless of score, above the postmortem block). A JUDGMENT is a
  // scorable prediction ("the LLM tends to drop exports on small
  // files") — it lives and dies by helped/hindered like the original
  // design. "advisory" marks a pruned procedure that was demoted
  // instead of deactivated: its content stays visible to the distiller
  // (never re-derived) but it no longer injects.
  kind      String   @default("judgment") // judgment | procedure | advisory

  // ── D1: LAPSE DETECTION (concept: pixle-codes/relapse) ─────────────
  // A LAPSE is a failure where a lesson was injected into the prompt,
  // the mutation failed anyway, AND the failure matches what the lesson
  // covers — the LLM read the rule and ignored it. Aggregate scoring
  // can't see this (a hindered verdict looks the same as an ignored
  // one); the lapse counter can. At lapseCount >= 3 the lesson is
  // re-injected with a HIGH-LAPSE warning prefix; at >= 6 it becomes a
  // candidate for force re-distillation (sharper phrasing from its own
  // lapse evidence).
  lapseCount    Int      @default(0)
  lastLapseAt   DateTime?
  lastLapseFile String?

  // ── D9: REVOCATION — the zombie-lesson kill switch (concept:
  // EMG reconcileContradictoryMemories) ────────────────────────────────
  // A lesson that earned a high score can go WRONG when the codebase
  // shifts under it. 4 consecutive hindered after score >= 0.6 means
  // reality contradicted the lesson: it is REVOKED (not merely pruned —
  // pruned lessons didn't help, revoked lessons actively hurt). The
  // distiller sees REVOKED lessons and is told not to re-derive
  // anything resembling them without strong new evidence. Procedures
  // are exempt (they demote via D2; a real procedure shouldn't be
  // revoked by 4 noisy judgments).
  consecutiveHindered Int      @default(0)
  revokedAt            DateTime?
  revocationReason     String?

  // Feedback counters — the measured half of the compounding loop.
  injected Int       @default(0) // times included in an enhance prompt
  helped   Int       @default(0) // of those, mutations that PASSED
  hindered Int       @default(0) // of those, mutations that FAILED

  // Trust score = helped/(helped+hindered), recomputed on every verdict.
  // Starts at 1.0 (benefit of the doubt). Lessons are selected for
  // injection in descending score order.
  score    Float     @default(1.0)

  // False once pruned (score fell below threshold with enough
  // observations). Kept for history — the distiller sees pruned lessons
  // so it doesn't re-derive a rule that already failed to transfer.
  active   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// ── D4: MUTATION DIFF CORPUS (concepts: reef receipt-linked records,
/// agent-flight-recorder per-session evidence, kai-evolve HMRD) ────────
/// One row per mutation ATTEMPT (pass or fail). The distiller's aggregate
/// digest shows failure-TYPE counts; the corpus shows the SHAPE of the
/// failures — which transform the LLM actually attempted, which lessons
/// were on board, which gate fired. Queryable forever: "across the last
/// 30 AST_SYMBOL_DROPPED failures, what transform did the model try?"
/// is a question this table can answer and the digest cannot.
///
/// Written by the runCycle wrapper (after the verdict lands) via
/// mutation-corpus.ts. Read by the distiller's history digest and the
/// meta-tuner's pass-rate windows. Protected in SCHEMA_PROTECTED_MODELS.
model MutationCorpus {
  id        String   @id @default(cuid())

  // Which cycle and which loop-NN branch the attempt belonged to.
  // branchNumber is null for attempts that never reached the push stage.
  cycleNumber  Int
  branchNumber Int?

  filePath  String
  // enhanced | typecheck-fail | debate-fail | test-fail | truncation |
  // schema-rejected | no-change | cosmetic | deferred | llm-unavailable | error
  gateOutcome String

  // The postmortem failureType when the attempt failed at a gate (null
  // for passes/defers) — read back from the postmortem table by the
  // corpus writer, so the corpus and the scar log agree by construction.
  failureType  String?

  // sha256 (first 16 hex) of the pre-mutation source — provenance for
  // "what did the file look like when this was attempted".
  originalSha  String
  mutatedSha   String?

  // The postmortem row id for this file (latest), when one exists.
  postmortemId String?

  // JSON array of lesson ids injected into this attempt's prompt.
  // String (not a list) — Prisma primitives only.
  lessonIdsInjected String   @default("[]")

  // One-line summary of what the mutation attempted (the LLM's own
  // "## Changes" first line) — the transform signal.
  transformSummary  String?

  createdAt DateTime @default(now())
}

/// ── D8: META-LOOP PARAMETER TUNER (concepts: Raven Evolver, the L4
/// meta-harness rung, genesis PromptEvolution) ──────────────────────────
/// The loop's own knobs (DISTILL_INTERVAL, MAX_INJECTED, PRUNE_SCORE,
/// MIN_OBSERVATIONS, SATURATION_THRESHOLD) were constants the system
/// never questioned. MetaParam makes them rows: seeded at boot, read
/// through a cached accessor by every consumer, and periodically tuned
/// by meta-tuner.ts via a measured A/B trial (propose → 20-cycle trial
/// window → accept only if pass-rate beats the prior window by ≥5pp,
/// else rollback). A row in "trial" provenance at boot is an orphaned
/// trial from a restart — reverted to its baseline.
///
/// The tuner file itself is in PROTECTED_FILES: the loop can never
/// rewrite its own tuner. Protected in SCHEMA_PROTECTED_MODELS.
model MetaParam {
  key         String   @id           // DISTILL_INTERVAL | MAX_INJECTED | PRUNE_SCORE | MIN_OBSERVATIONS | SATURATION_THRESHOLD
  value       String                 // serialized (int/float as string)
  valueType   String   @default("int") // int | float
  provenance  String   @default("seed") // seed | trial | meta-tuned
  baselineValue String?              // last accepted value — the rollback target
  proposedBy  String?                // "tuner-cycle-<N>" audit trail
  acceptedAt  DateTime?
  trialPassRate   Float?             // pass rate during the trial window
  baselinePassRate Float?           // pass rate in the prior equal-length window
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// ── COGNITIVE CORE (audit 7): the loop's measured self-knowledge ─────
/// Two tables make the loop's "self-awareness" real instead of narrative:
///
/// SelfModelFile — per-file performance memory. What the loop knows about
/// its own success on every file it has ever mutated: attempts, passes,
/// fails, zero-diffs, exhaustion score, per-mode stats. Bootstrapped from
/// MutationCorpus history (instant self-knowledge from 400+ past
/// attempts) + archaeology stability maps, updated after every verdict.
/// Powers UCB bandit target selection — the loop CHOOSES what to work on
/// based on what it knows about itself, instead of tree-order scanning.
///
/// SelfPrediction — the loop's predictions about its OWN success, made
/// before each mutation attempt and resolved immediately after the gate
/// verdict. The calibration curve over resolved rows is self-awareness
/// you can MEASURE: "when I say 70% confident, am I right 70% of the
/// time?" Brier score over all resolved predictions is the loop's single
/// number for "how well do I know myself".
model SelfModelFile {
  id          String   @id @default(cuid())
  filePath    String   @unique
  attempts    Int      @default(0)
  passes      Int      @default(0)
  fails       Int      @default(0)
  zeroDiffs   Int      @default(0)
  visualPolishAttempts Int @default(0)
  visualPolishPasses    Int @default(0)
  lastTouchedAt DateTime?
  lastOutcome String?  // pass | fail | zero-diff
  /// Empirical exhaustion 0..1 — consecutive zero-diffs push toward 1,
  /// a pass pulls back down. Feeds the bandit's exploration penalty.
  finishedScore Float  @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SelfPrediction {
  id          String   @id @default(cuid())
  filePath    String
  mode        String   // refactor | visual-polish
  /// The predicted probability (0..1) that this attempt passes ALL gates
  /// (typecheck + structural + mutation-guard + debate + test).
  confidence  Float
  outcome     String?  // pass | fail | zero-diff | excluded
  cycleNumber Int
  /// Self-explanation: WHY this confidence (empirical rate, recency,
  /// exhaustion). The loop's reasoning, in its own record.
  reason      String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
}
