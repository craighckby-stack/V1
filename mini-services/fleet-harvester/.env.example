# fleet-harvester - detached fleet-history harvester (port 3010)
#
# STEP 2 (current): adapted githubClient.ts (btoa->Buffer) + new
# aiOrchestrator.ts using z-ai-web-dev-sdk (Gemini removed). The LLM
# provider is Z.AI, reused from the main LOOP project's cortex — no
# Gemini or NVIDIA keys are needed.
#
# --- LLM provider (step 2+: aiOrchestrator uses z-ai-web-dev-sdk) ---
# Z.AI is auto-configured by the same cortex the main LOOP project uses;
# no key is needed here. The SDK reads its own configuration.
#
# --- GitHub (step 2+: githubClient - fleet discovery + V1 destination push) ---
GITHUB_TOKEN=
#
# --- Destination + scheduler (step 4+) ---
# V1 archive repo where the three corpus JSON files are pushed.
V1_DEST_REPO=
V1_DEST_BRANCH=main
# Local LOOP memory/ dir to mirror the corpus atomically.
LOOP_MEMORY_DIR=
# How often the detached harvester fires (ms). 86400000 = daily.
HARVEST_INTERVAL_MS=86400000
# Budget cap: max ambiguous commits sent to the LLM per harvest.
MAX_LLM_COMMITS_PER_HARVEST=500
# Self-referential bias guard: exclude these repos (comma-sep) from the fleet
# so LOOP doesn't harvest its own history into its own lesson substrate.
EXCLUDE_REPOS=
