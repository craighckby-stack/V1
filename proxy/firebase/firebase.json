{
  "functions": {
    "source": "functions",
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  },
  "hosting": {
    "public": "hosting-public",
    "rewrites": [
      { "source": "/v1beta/**", "function": "geminiProxy" },
      { "source": "/v1/**", "function": "geminiProxy" },
      { "source": "/health", "function": "geminiProxy" }
    ],
    "ignore": ["**/.*", "**/.gitkeep"]
  }
}
