# Local-only env file. NEVER commit real secrets. Copy to .env and fill in.
# On Fly, secrets live in `fly secrets` — this file is for local testing only.

# Shared secret between LOOP and this proxy. Generate with:
#   openssl rand -hex 32
# LOOP pastes this value where it would normally paste a Gemini API key.
PROXY_SECRET=replace-with-output-of-openssl-rand-hex-32

# Real Google Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# Lives ONLY on the proxy host. Never enters the LOOP sandbox.
GEMINI_API_KEY=replace-with-your-ai-studio-key

# Optional: override the listen port for local testing.
# PORT=8787
